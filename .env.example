# Copy this file to .env and fill in your values.
# Never commit .env to git.

# This is the SAME Supabase project as license-manager, not a separate one —
# see SETUP.md step 1. Use license-manager's Project URL / anon key here too.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Set via `supabase secrets set` for the embed-document edge function, not consumed by the Vite app.
VOYAGE_API_KEY=your-voyage-api-key-here

# Voyage AI trains on submitted content by default. Before setting this to
# true, opt out of training in the Voyage AI account dashboard (account-level
# setting, not an API flag) — this corpus is internal SIL ticket content.
# The embed-document function refuses to call Voyage AI until this is "true".
VOYAGE_TRAINING_OPT_OUT_CONFIRMED=false

# Set via `supabase secrets set` for the helpdesk-inbound edge function, not consumed by the Vite app.
# See SETUP.md step 9. Resend: API key (reads received mail) and the webhook
# endpoint's signing secret; the function refuses to run without the latter.
# Named HELPDESK_-prefixed because this Supabase project's secrets are shared
# with license-manager (one flat namespace, not scoped per function/app).
HELPDESK_RESEND_API_KEY=re_your-resend-api-key
HELPDESK_RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Optional: enables re-processing one stored email by hand (SETUP.md 9d). Leave unset to disable.
# HELPDESK_REPROCESS_SECRET=generate-with-openssl-rand-hex-32
# Optional tuning
# HELPDESK_MAX_ATTACHMENT_BYTES=10485760
