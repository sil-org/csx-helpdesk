{
  "name": "helpdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:inbound": "node --experimental-strip-types --no-warnings --test supabase/functions/helpdesk-inbound/*.test.ts",
    "test:draft": "node --experimental-strip-types --no-warnings --test supabase/functions/generate-draft/*.test.ts",
    "test:kb": "node --experimental-strip-types --no-warnings --test supabase/functions/refresh-kb-cache/*.test.ts",
    "test:kbtext": "node --test src/lib/kbText.test.js",
    "test:kbsync": "node --experimental-strip-types --no-warnings --test supabase/functions/sync-kb-articles/*.test.ts",
    "test:notify": "node --experimental-strip-types --no-warnings --test supabase/functions/notify-agent-added/*.test.ts",
    "test:assignee": "node --experimental-strip-types --no-warnings --test supabase/functions/notify-assignee/*.test.ts",
    "test:sender": "node --experimental-strip-types --no-warnings --test supabase/functions/_shared/*.test.ts",
    "test:reply": "node --experimental-strip-types --no-warnings --test supabase/functions/send-reply/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^1.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "supabase": "^2.108.0",
    "tailwindcss": "^3.4.14",
    "vite": "^6.4.5"
  }
}
